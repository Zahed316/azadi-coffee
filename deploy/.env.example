# ─── Domain ───────────────────────────────────────────
# The live website domain. Set during server installation.
# Example: azadicoffee.com (no protocol, no www)
DOMAIN=localhost

# ─── Site URLs ───────────────────────────────────────
# These are derived from DOMAIN by default.
NEXT_PUBLIC_SITE_URL=https://${DOMAIN}
WORDPRESS_BASE_URL=https://${DOMAIN}/wp
WORDPRESS_API_URL=https://${DOMAIN}/wp-json

# ─── WooCommerce ─────────────────────────────────────
# REST API credentials (WooCommerce > Settings > Advanced > REST API).
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ─── WordPress Application Auth ──────────────────────
# For admin API calls (Users > Application Passwords).
WORDPRESS_APPLICATION_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
